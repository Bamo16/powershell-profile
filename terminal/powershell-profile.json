{
    // A Windows Terminal fragment. install.ps1 links this folder into Terminal's Fragments folder, so
    // Terminal reads it at startup. Fragments can add profiles and schemes and change the built-in
    // PowerShell profiles; global settings (default profile, key bindings) stay in Terminal's own settings.
    "profiles": [
        // One Half Dark is the palette starship.toml's segments are drawn from.
        {
            // Terminal's GUID for whichever pwsh it ranks first.
            "updates": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
            "colorScheme": "One Half Dark"
        },
        {
            // "PowerShell 7", shown when a second pwsh install exists.
            "updates": "{5fb123f1-af88-5b5c-8953-d14a8def1978}",
            "colorScheme": "One Half Dark"
        },
        {
            // Windows PowerShell.
            "updates": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
            "colorScheme": "One Half Dark"
        },
        {
            // Opens in its own elevated window: Terminal can't mix elevated and normal tabs.
            "guid": "{4c9108dc-c999-5d16-9702-5d4c235a770e}",
            "name": "PowerShell (Admin)",
            "commandline": "pwsh.exe -NoLogo",
            "elevate": true,
            // Segoe Fluent Icons' admin shield, and the elevated prompt segment's orange.
            "icon": "",
            "tabColor": "#d19a66",
            "colorScheme": "One Half Dark"
        }
    ]
}
